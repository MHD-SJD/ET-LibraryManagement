# Download this private file from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# The React dev server address. Add a comma-separated list for production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business rules
LOAN_DURATION_DAYS=14
DEFAULT_BORROW_LIMIT=5

# Prototype administrator created on the first backend start.
# Change this password before publishing or deploying the project.
DEFAULT_ADMIN_EMAIL=admin@auralib.lk
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=AuraLib Administrator
